# Copy this file to `.env` for local development, and add the same variables in
# Netlify → Site configuration → Environment variables for the live site.

# Secret key the blog API requires (send it as `Authorization: Bearer <key>`).
# Generate one with:  openssl rand -hex 32
BLOG_API_KEY=

# Fine-grained GitHub token, scoped to ONLY this repo, with
# "Contents: Read and write" permission. The blog API uses it to commit posts
# as Markdown files into src/content/blog/, which triggers a Netlify rebuild.
# Leave empty locally: in `npm run dev` the API writes to your local files instead.
GITHUB_TOKEN=

# owner/repo of this project on GitHub, e.g. arndiddi/personal-website
GITHUB_REPO=

# Branch Netlify deploys from.
GITHUB_BRANCH=main
