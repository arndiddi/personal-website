---
import type { CollectionEntry } from 'astro:content';
interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}
const { project, headingLevel: H = 'h3' } = Astro.props;
const { title, summary, status, dates, stack, outcome, draft } = project.data;
---

<a href={`/portfolio/${project.id}`} class="card card-link flex h-full flex-col gap-3">
  <div class="flex items-start justify-between gap-3">
    <span class="micro text-dim">{dates}</span>
    <span class:list={['status-chip !text-[12.5px]', (draft || status === 'In progress') && 'status-chip--gold']}>
      {draft ? 'Draft' : status}
    </span>
  </div>
  <H class="card-title">{title}</H>
  <p class="text-small text-muted">{summary}</p>
  {
    outcome && (
      <p class="text-small rounded-xl bg-bg-elevated px-4 py-3 text-ink">
        {outcome}
      </p>
    )
  }
  <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
    {stack.slice(0, 4).map((s) => <span class="tag">{s}</span>)}
  </div>
  <span class="text-[14px] font-semibold">Read case study →</span>
</a>
