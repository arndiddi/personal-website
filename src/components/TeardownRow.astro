---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';
interface Props {
  teardown: CollectionEntry<'teardowns'>;
}
const { teardown } = Astro.props;
const { title, company, product, summary, focus, pubDate, tags, draft } = teardown.data;
---

<article class="grid-teardown border-t border-line py-7 first:border-t-0 first:pt-0">
  <div class="flex flex-col gap-1.5">
    <span class="micro text-accent-2">{company}</span>
    <span class="text-small text-muted">{product}</span>
    <span class="micro text-dim">{formatDate(pubDate, 'short')}</span>
    {draft && <span class="status-chip status-chip--gold mt-2 self-start">Draft</span>}
  </div>
  <div>
    <h3 class="card-title text-[1.25rem]">
      <a href={`/portfolio/teardowns/${teardown.id}`} class="hover:text-accent hover:underline underline-offset-4">
        {title}
      </a>
    </h3>
    <p class="mt-2 text-muted">{summary}</p>
    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      <span class="tag !border-accent !text-accent">Focus: {focus}</span>
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  </div>
</article>
