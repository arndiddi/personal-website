---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-line bg-bg-elevated/60">
  <div class="container-ledger flex flex-col gap-6 py-10 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="font-mono text-[15px] font-medium">
        <span class="mr-2 inline-block h-[7px] w-[7px] rounded-full bg-accent align-middle"></span>arnav.diddi
      </p>
      <p class="text-small mt-2 max-w-[44ch] text-muted">
        Aspiring product manager. Recruiting for Summer 2027 PM internships. Always happy to talk product, AI, or anime.
      </p>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-[12.5px]">
      <li><a class="link" href={`mailto:${site.email}`}>Email</a></li>
      <li><a class="link" href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
      <li><a class="link" href={site.github} rel="me noopener" target="_blank">GitHub</a></li>
      <li><a class="link" href={site.resumePdf}>Resume (PDF)</a></li>
      <li><a class="link" href="/rss.xml">RSS</a></li>
    </ul>
  </div>
  <div class="container-ledger pb-8">
    <p class="micro text-dim">© {year} {site.name} · Built with Astro + Tailwind, deployed on Netlify</p>
  </div>
</footer>
