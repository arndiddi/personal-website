---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-line">
  <div class="container-ledger flex flex-col gap-8 py-12 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="font-display text-[26px] italic leading-none">{site.name}</p>
      <p class="text-small mt-3 max-w-[44ch] text-muted">
        Aspiring product manager. Recruiting for Summer 2027 PM internships. Always happy to talk product, AI, or anime.
      </p>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[14.5px] font-medium text-muted">
      <li><a class="hover:text-ink" href={`mailto:${site.email}`}>Email</a></li>
      <li><a class="hover:text-ink" href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
      <li><a class="hover:text-ink" href={site.github} rel="me noopener" target="_blank">GitHub</a></li>
      <li><a class="hover:text-ink" href={site.resumePdf}>Resume (PDF)</a></li>
      <li><a class="hover:text-ink" href="/rss.xml">RSS</a></li>
    </ul>
  </div>
  <div class="container-ledger pb-10">
    <p class="micro text-dim">© {year} {site.name} · Built with Astro + Tailwind, deployed on Netlify</p>
  </div>
</footer>
