---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/content';
interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, tags, draft } = post.data;
---

<article class="grid-teardown border-t border-line py-7 first:border-t-0 first:pt-0">
  <div class="flex flex-col gap-1">
    <time datetime={pubDate.toISOString()} class="micro text-dim">{formatDate(pubDate, 'short')}</time>
    <span class="micro text-dim">{readingTime(post.body)} min read</span>
    {draft && <span class="status-chip status-chip--gold mt-2 self-start">Draft</span>}
  </div>
  <div>
    <h3 class="card-title text-[1.25rem]">
      <a href={`/blog/${post.id}`} class="hover:text-accent hover:underline underline-offset-4">{title}</a>
    </h3>
    <p class="mt-2 text-muted">{description}</p>
    {
      tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      )
    }
  </div>
</article>
