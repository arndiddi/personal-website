---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TeardownRow from '../components/TeardownRow.astro';
import PostRow from '../components/PostRow.astro';
import headshot from '../assets/headshot.jpg';
import { site, hero, currently } from '../data/site';
import { getPosts, getProjects, getTeardowns } from '../lib/content';

// "Featured" = anything with `featured: true` in its Markdown frontmatter.
const featuredProjects = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
const featuredTeardowns = (await getTeardowns()).filter((t) => t.data.featured).slice(0, 2);
const posts = await getPosts();
const featuredPosts = [...posts.filter((p) => p.data.featured), ...posts.filter((p) => !p.data.featured)].slice(0, 2);
---

<BaseLayout>
  <!-- Hero -->
  <section class="pt-20 pb-24 max-md:pt-12 max-md:pb-16">
    <div class="container-ledger hero-grid">
      <div class="hero-copy">
        <span class="status-chip">{site.status}</span>
        <p class="mt-7 max-w-[46ch] text-[17px] leading-[1.7] text-muted">{hero.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/portfolio" class="btn btn-primary">See my work</a>
          <a href="/resume" class="btn btn-ghost">View resume</a>
        </div>
      </div>

      <h1 class="hero-name hero-title">{hero.headline} <em>{hero.accent}</em></h1>

      <figure class="hero-photo">
        <Image
          src={headshot}
          alt="Arnav Diddi in a dark suit and white shirt, smiling slightly"
          widths={[400, 600, 900]}
          sizes="(max-width: 819px) 92vw, 460px"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full rounded-[22px] object-cover object-[50%_62%]"
        />
      </figure>

      <dl class="hero-facts">
        {
          hero.facts.map((f) => (
            <div>
              <dt class="micro text-dim">{f.label}</dt>
              <dd class="mt-1 text-[15px] font-medium">{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Featured -->
  <section class="section !pt-8" aria-labelledby="featured-title">
    <div class="container-ledger">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeader id="featured-title" eyebrow="Featured work" title="Things I've built," accent="and why." class="!mb-12">
          Each project is written up as a short case study: the problem, who it's for, the calls I made, and how I'd
          know it's working.
        </SectionHeader>
        <a href="/portfolio" class="link mb-12 text-[15px] font-medium">All projects & teardowns →</a>
      </div>

      <div class="grid-cards">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>

      {
        featuredTeardowns.length > 0 && (
          <div class="mt-16">
            <h3 class="eyebrow mb-5">Featured teardown</h3>
            <div class="card !p-8 max-sm:!p-6">
              {featuredTeardowns.map((t) => (
                <TeardownRow teardown={t} />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- Brief about + Currently -->
  <section class="section" aria-labelledby="about-title">
    <div class="container-ledger grid-about">
      <div>
        <SectionHeader id="about-title" eyebrow="In brief" title="A little" accent="about me." class="!mb-8" />
        <div class="max-w-[60ch] space-y-4 text-[17px] text-[#3b3631]">
          <p>
            I like owning a product end to end: understanding it inside and out, finding where it falls short, and
            working with people to make it better. That's what pulled me toward product management.
          </p>
          <p>
            At Rutgers I double-majored in Computer Science and Business Analytics & IT, so I'm comfortable on both
            sides of the table, whether that's writing SQL or talking through trade-offs with stakeholders. At
            J&J, I helped roll out a generative AI testing tool and learned that adoption is a product problem,
            not just a technical one.
          </p>
          <p>
            Outside of work I'm pretty social. You'll usually find me at the gym, on a basketball court, or
            somewhere on a mountain going down a run I probably shouldn't be on.
          </p>
        </div>
        <a href="/about" class="btn btn-ghost mt-8">More about me</a>
      </div>

      <aside aria-labelledby="currently-title" class="md:pt-[62px]">
        <h2 id="currently-title" class="eyebrow mb-4">Currently</h2>
        <dl class="fields">
          {
            currently.map((row) => (
              <div>
                <dt>{row.key}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </section>

  <!-- Writing -->
  {
    featuredPosts.length > 0 && (
      <section class="section" aria-labelledby="writing-title">
        <div class="container-ledger">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <SectionHeader id="writing-title" eyebrow="Writing" title="From the" accent="blog." class="!mb-10" />
            <a href="/blog" class="link mb-10 text-[15px] font-medium">
              All posts →
            </a>
          </div>
          {featuredPosts.map((post) => (
            <PostRow post={post} />
          ))}
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section class="section !pt-4">
    <div class="container-ledger">
      <div class="cta-band">
        <div>
          <p class="text-[13.5px] font-medium text-[#b9b4ab]">Open to opportunities</p>
          <h2 class="mt-3 text-[clamp(2rem,4.5vw,3.2rem)] leading-[1.05] tracking-[-0.02em]">
            Hiring a Summer 2027 <em class="text-[#9a958c]">PM intern?</em>
          </h2>
          <p class="mt-4 max-w-[50ch] text-[#cfcac1]">
            I'd love to hear about the product and the team. Recruiters, PMs, and fellow builders are all welcome.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 md:shrink-0">
          <a href="/contact" class="btn bg-bg text-ink hover:bg-white">Contact me</a>
          <a href={site.resumePdf} class="btn border-[#4a443d] text-bg hover:border-bg" download>Download resume</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    grid-template-areas:
      'copy  .'
      'title photo'
      'facts photo';
    column-gap: 48px;
    align-items: start;
  }
  .hero-copy {
    grid-area: copy;
  }
  .hero-title {
    grid-area: title;
    margin-top: 72px;
  }
  .hero-photo {
    grid-area: photo;
    margin-top: 190px;
  }
  .hero-facts {
    grid-area: facts;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 56px;
    padding-top: 22px;
    border-top: 1px solid var(--color-line);
    align-self: end;
  }
  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    padding: 56px;
    border-radius: 28px;
    background: var(--color-ink);
    color: var(--color-bg);
  }
  @media (max-width: 819px) {
    .hero-grid {
      grid-template-columns: 1fr;
      grid-template-areas: 'copy' 'title' 'photo' 'facts';
    }
    .hero-title {
      margin-top: 48px;
    }
    .hero-photo {
      margin-top: 36px;
      max-width: 460px;
    }
    .hero-facts {
      margin-top: 36px;
    }
    .cta-band {
      padding: 36px 28px;
    }
  }
  @media (max-width: 559px) {
    .hero-facts {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
