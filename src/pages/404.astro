---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="section">
    <div class="container-ledger flex flex-col items-start gap-6">
      <span class="status-chip status-chip--gold">Error 404</span>
      <h1 class="hero-name">This page isn't in the ledger.</h1>
      <p class="lede max-w-[52ch]">The link may be old, or the page may have moved.</p>
      <div class="flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">Go home</a>
        <a href="/portfolio" class="btn btn-ghost">See my work</a>
      </div>
    </div>
  </section>
</BaseLayout>
