---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DraftBanner from '../../../components/DraftBanner.astro';
import { getTeardowns, formatDate, readingTime } from '../../../lib/content';

export async function getStaticPaths() {
  const teardowns = await getTeardowns();
  return teardowns.map((teardown) => ({ params: { slug: teardown.id }, props: { teardown } }));
}

const { teardown } = Astro.props;
const { title, summary, company, product, focus, pubDate, tags, draft } = teardown.data;
const { Content } = await render(teardown);
---

<BaseLayout title={title} description={summary} type="article" publishedTime={pubDate}>
  <article class="section !pt-[72px] max-md:!pt-12">
    <div class="container-ledger">
      <a href="/portfolio#teardowns" class="micro text-muted hover:text-accent">← All teardowns</a>
      {draft && <div class="mt-6"><DraftBanner /></div>}

      <header class="mt-8 mb-12 max-w-[760px]">
        <p class="eyebrow mb-3">Teardown · {company}</p>
        <h1 class="article-title">{title}</h1>
        <p class="lede mt-5">{summary}</p>
      </header>

      <div class="grid-teardown items-start">
        <dl class="fields md:sticky md:top-[88px]">
          <div><dt>Company</dt><dd>{company}</dd></div>
          <div><dt>Product</dt><dd>{product}</dd></div>
          <div><dt>Focus</dt><dd>{focus}</dd></div>
          <div><dt>Published</dt><dd><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></dd></div>
          <div><dt>Read</dt><dd>{readingTime(teardown.body)} min</dd></div>
          {tags.length > 0 && <div><dt>Tags</dt><dd class="mt-1 flex flex-wrap gap-1.5">{tags.map((t) => <span class="tag">{t}</span>)}</dd></div>}
        </dl>
        <div class="prose prose-ledger min-w-0">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
