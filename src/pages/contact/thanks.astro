---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Message sent" description="Thanks for reaching out.">
  <section class="section">
    <div class="container-ledger flex flex-col items-start gap-6">
      <span class="status-chip">Received ✓</span>
      <h1 class="hero-name">Thanks for reaching out!</h1>
      <p class="lede max-w-[52ch]">Your message landed in my inbox. I'll get back to you within a day or two.</p>
      <div class="flex flex-wrap gap-3">
        <a href="/portfolio" class="btn btn-primary">Browse my work</a>
        <a href="/" class="btn btn-ghost">Back home</a>
      </div>
    </div>
  </section>
</BaseLayout>
